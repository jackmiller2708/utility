# Copy to .env and fill in real values. .env is gitignored — never commit it.

# LAN-only hostname, served with Caddy's internal (self-signed) CA.
LAN_HOSTNAME=utility.home.arpa

# This host's current LAN IP (`hostname -I` / `ip -brief addr`). Caddy binds
# its published ports here specifically rather than 0.0.0.0, so it doesn't
# also grab port 443 on the Tailscale interface (see LAN_IP's comment in
# docker-compose.yml and docs/tailscale-funnel-setup.md). Get a DHCP
# reservation for this host so it stops drifting; until then, update this
# whenever it changes.
LAN_IP=192.168.1.29

# This host's public Tailscale Funnel hostname (from `tailscale dns status`
# / `tailscale status` — the MagicDNS suffix + this machine's hostname, e.g.
# pop-os.tail05fd35.ts.net). Port forwarding can't work here (ISP CGNAT — see
# docs/tailscale-funnel-setup.md), so this is how the app is publicly
# reachable instead. Only used to widen CORS_ORIGINS/NG_ALLOWED_HOSTS; the
# Funnel routing itself is native `tailscale` CLI config, not Docker.
TAILSCALE_HOSTNAME=

# Grafana's bootstrap admin password (username: admin). Only takes effect on Grafana's
# first boot -- changing it later has no effect until you reset the account, since Grafana
# persists it into the grafana_data volume. Only used on the LAN Caddy route, never the
# public Funnel one, but still don't leave this as the "admin" fallback.
GRAFANA_ADMIN_PASSWORD=
